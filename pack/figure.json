{
  "manifest": 2,
  "api": 2,
  "id": "aemeath-pixel-flight",
  "version": "1.0.0",
  "name": {
    "zh": "爱弥斯·像素飞行",
    "en": "Aemeath · Pixel Flight"
  },
  "about": {
    "en": "A front-facing pixel character with mechanical wings, hovering and two-dimensional flight. Eight complete bundled song recordings are available through pet_act, without a separate music tool or voice synthesis. Infer the requested title from natural sing/play/listen requests, including Chinese or English names and common short names; no book-title brackets or exact phrasing are required. For example, 唱个星炬不熄 uses pet_act({\"actions\":[\"song-unwavering-startorch\"]}). Use sing for an unspecified full song and dance for the short la-la-la clip. Full songs are on request only; dance throughout playback, then hover. Optional musicControl enables stop/replace; its absence does not disable named-song playback."
  },
  "entry": "figure.js",
  "export": "createPixelFlight",
  "model": "animations.json",
  "thumb": "assets/thumb.png",
  "axes": [],
  "presets": [],
  "sounds": {
    "dango-sing": {
      "file": "assets/audio-boosted/dango-sing.wav",
      "kind": "move",
      "volume": 1
    },
    "dango-defeat1": {
      "file": "assets/audio-boosted/dango-defeat1.wav",
      "kind": "face",
      "volume": 1
    },
    "dango-happy1": {
      "file": "assets/audio-boosted/dango-happy1.wav",
      "kind": "face",
      "volume": 1
    },
    "dango-defeat2": {
      "file": "assets/audio-boosted/dango-defeat2.wav",
      "kind": "face",
      "volume": 1
    },
    "dango-defeat3": {
      "file": "assets/audio-boosted/dango-defeat3.wav",
      "kind": "face",
      "volume": 1
    },
    "dango-happy2": {
      "file": "assets/audio-boosted/dango-happy2.wav",
      "kind": "face",
      "volume": 1
    },
    "poke": {
      "file": "assets/audio-boosted/poke.wav",
      "kind": "touch",
      "volume": 1
    },
    "grab": {
      "file": "assets/audio-boosted/grab.wav",
      "kind": "touch",
      "volume": 1
    },
    "pop": {
      "file": "assets/audio-boosted/pop.wav",
      "kind": "touch",
      "volume": 1
    },
    "purr": {
      "file": "assets/audio-boosted/purr.wav",
      "kind": "touch",
      "volume": 1
    },
    "music-paper-plane": {
      "file": "assets/songs/纸飞机.mp3",
      "kind": "move",
      "volume": 1
    },
    "music-indigo-universe": {
      "file": "assets/songs/靛青宇宙.mp3",
      "kind": "move",
      "volume": 1
    },
    "music-fallen-petals": {
      "file": "assets/songs/碎花.mp3",
      "kind": "move",
      "volume": 1
    },
    "music-unwavering-startorch": {
      "file": "assets/songs/星炬不熄.mp3",
      "kind": "move",
      "volume": 1
    },
    "music-small-miracle": {
      "file": "assets/songs/小小奇迹.mp3",
      "kind": "move",
      "volume": 1
    },
    "music-deadline-disco": {
      "file": "assets/songs/极限迪斯科.mp3",
      "kind": "move",
      "volume": 1
    },
    "music-voyaging-star-farewell": {
      "file": "assets/songs/远航星的告别.mp3",
      "kind": "move",
      "volume": 1
    },
    "music-vernal-days": {
      "file": "assets/songs/那颗星梦见的春日.mp3",
      "kind": "move",
      "volume": 1
    }
  },
  "can": {
    "walk": true
  },
  "vocab": [
    {
      "id": "hover",
      "kind": "motion",
      "names": {
        "zh": [
          "悬停"
        ]
      },
      "about": {
        "en": "Hover at the current position."
      },
      "seconds": 1,
      "lasting": true
    },
    {
      "id": "ascend",
      "kind": "motion",
      "names": {
        "zh": [
          "上升"
        ]
      },
      "about": {
        "en": "Fly upward, then hover. Stops at the top edge."
      },
      "seconds": 2
    },
    {
      "id": "descend",
      "kind": "motion",
      "names": {
        "zh": [
          "下降"
        ]
      },
      "about": {
        "en": "Fly downward, then hover. Stops at the bottom edge."
      },
      "seconds": 2
    },
    {
      "id": "fly",
      "kind": "motion",
      "names": {
        "zh": [
          "飞行"
        ]
      },
      "about": {
        "en": "Fly to a random two-dimensional position inside the current stage."
      },
      "seconds": 4
    },
    {
      "id": "dash",
      "kind": "motion",
      "names": {
        "zh": [
          "疾飞"
        ]
      },
      "about": {
        "en": "Fly faster to a random position inside the current stage."
      },
      "seconds": 3
    },
    {
      "id": "happy",
      "kind": "expression",
      "names": {
        "zh": [
          "开心"
        ]
      },
      "about": {
        "en": "Smile while flapping the wings. Play one animation cycle, then return to hover."
      },
      "seconds": 0.88
    },
    {
      "id": "excited",
      "kind": "expression",
      "names": {
        "zh": [
          "期待"
        ]
      },
      "about": {
        "en": "Smile and bob while flapping the wings. Play one animation cycle, then return to hover."
      },
      "seconds": 0.77
    },
    {
      "id": "dance",
      "kind": "motion",
      "names": {
        "zh": [
          "跳舞",
          "哼歌",
          "啦啦啦"
        ],
        "en": [
          "hum"
        ]
      },
      "about": {
        "en": "Dance with the short la-la-la clip, then hover. For a complete song, use sing or the matching song action."
      },
      "seconds": 1.48
    },
    {
      "id": "rest",
      "kind": "motion",
      "names": {
        "zh": [
          "休息"
        ]
      },
      "about": {
        "en": "Close the eyes while hovering at the current position. Play one animation cycle, then return to hover."
      },
      "seconds": 2.75
    },
    {
      "id": "flustered",
      "kind": "expression",
      "names": {
        "zh": [
          "慌张"
        ]
      },
      "about": {
        "en": "Squeeze the eyes shut and flap vigorously. Play one animation cycle, then return to hover."
      },
      "seconds": 0.77
    },
    {
      "id": "love",
      "kind": "expression",
      "names": {
        "zh": [
          "喜欢"
        ]
      },
      "about": {
        "en": "Smile while small pixel hearts float upward. Play one animation cycle, then return to hover."
      },
      "seconds": 0.88
    },
    {
      "id": "look",
      "kind": "motion",
      "names": {
        "zh": [
          "张望"
        ]
      },
      "about": {
        "en": "Tilt gently from side to side while facing forward; the eyes are not independently rigged."
      },
      "seconds": 2
    },
    {
      "id": "faint",
      "kind": "motion",
      "names": {
        "zh": [
          "装晕"
        ]
      },
      "about": {
        "en": "Close the eyes and dim briefly while playing one supplied defeat sound. Recover automatically. Also available in the click cycle; never chosen during autonomous activity. Play one animation cycle, then return to hover."
      },
      "seconds": 2.75
    },
    {
      "id": "sing",
      "kind": "motion",
      "names": {
        "zh": [
          "唱歌",
          "唱一首歌",
          "听歌",
          "随机唱歌"
        ],
        "en": [
          "singing",
          "randomsong"
        ]
      },
      "about": {
        "en": "Play a random complete bundled song and dance until it ends. Use the matching song action when a title is specified. Only on request."
      },
      "seconds": 1
    },
    {
      "id": "song-paper-plane",
      "kind": "motion",
      "names": {
        "zh": [
          "纸飞机",
          "紙飛機",
          "纸飞"
        ],
        "en": [
          "PaperPlane",
          "paper-plane"
        ]
      },
      "about": {
        "en": "Play the COMPLETE bundled recording of 纸飞机 via pet_act({\"actions\":[\"song-paper-plane\"]}). Dance until the recording ends. Only on request."
      },
      "seconds": 1
    },
    {
      "id": "song-indigo-universe",
      "kind": "motion",
      "names": {
        "zh": [
          "靛青宇宙",
          "靛青",
          "靛蓝宇宙"
        ],
        "en": [
          "IndigoUniverse",
          "indigo-universe"
        ]
      },
      "about": {
        "en": "Play the COMPLETE bundled recording of 靛青宇宙 via pet_act({\"actions\":[\"song-indigo-universe\"]}). Dance until the recording ends. Only on request."
      },
      "seconds": 1
    },
    {
      "id": "song-fallen-petals",
      "kind": "motion",
      "names": {
        "zh": [
          "碎花",
          "碎花歌"
        ],
        "en": [
          "FallenPetals",
          "fallen-petals"
        ]
      },
      "about": {
        "en": "Play the COMPLETE bundled recording of 碎花 via pet_act({\"actions\":[\"song-fallen-petals\"]}). Dance until the recording ends. Only on request."
      },
      "seconds": 1
    },
    {
      "id": "song-unwavering-startorch",
      "kind": "motion",
      "names": {
        "zh": [
          "星炬不熄",
          "星炬不息",
          "星炬",
          "星炬不灭"
        ],
        "en": [
          "UnwaveringStartorch",
          "startorch"
        ]
      },
      "about": {
        "en": "Play the COMPLETE bundled recording of 星炬不熄 via pet_act({\"actions\":[\"song-unwavering-startorch\"]}). Dance until the recording ends. Only on request."
      },
      "seconds": 1
    },
    {
      "id": "song-small-miracle",
      "kind": "motion",
      "names": {
        "zh": [
          "小小奇迹",
          "小小奇蹟",
          "小小奇跡",
          "小奇迹"
        ],
        "en": [
          "ASmallMiracle",
          "SmallMiracle"
        ]
      },
      "about": {
        "en": "Play the COMPLETE bundled recording of 小小奇迹 via pet_act({\"actions\":[\"song-small-miracle\"]}). Dance until the recording ends. Only on request."
      },
      "seconds": 1
    },
    {
      "id": "song-deadline-disco",
      "kind": "motion",
      "names": {
        "zh": [
          "极限迪斯科",
          "极限Disco",
          "极限disco",
          "极限迪斯扣"
        ],
        "en": [
          "DeadlineDisco",
          "deadline-disco"
        ]
      },
      "about": {
        "en": "Play the COMPLETE bundled recording of 极限迪斯科 via pet_act({\"actions\":[\"song-deadline-disco\"]}). Dance until the recording ends. Only on request."
      },
      "seconds": 1
    },
    {
      "id": "song-voyaging-star-farewell",
      "kind": "motion",
      "names": {
        "zh": [
          "远航星的告别",
          "遠航星的告別",
          "远航星",
          "远航的告别",
          "远航告别"
        ],
        "en": [
          "VoyagingStar'sFarewell",
          "VoyagingStarsFarewell"
        ]
      },
      "about": {
        "en": "Play the COMPLETE bundled recording of 远航星的告别 via pet_act({\"actions\":[\"song-voyaging-star-farewell\"]}). Dance until the recording ends. Only on request."
      },
      "seconds": 1
    },
    {
      "id": "song-vernal-days",
      "kind": "motion",
      "names": {
        "zh": [
          "那颗星梦见的春日",
          "那顆星夢見的春日",
          "那颗星",
          "梦见的春日",
          "星梦春日",
          "春日"
        ],
        "en": [
          "VernalDaysDreamedByTheStar",
          "VernalDays"
        ]
      },
      "about": {
        "en": "Play the COMPLETE bundled recording of 那颗星梦见的春日 via pet_act({\"actions\":[\"song-vernal-days\"]}). Dance until the recording ends. Only on request."
      },
      "seconds": 1
    },
    {
      "id": "stop-singing",
      "kind": "motion",
      "names": {
        "zh": [
          "停止唱歌",
          "停止播放",
          "停歌",
          "别唱了",
          "不要唱了",
          "停止音乐"
        ],
        "en": [
          "stopmusic",
          "stopsinging"
        ]
      },
      "about": {
        "en": "Immediately stop the full song and return to hover. Available only when the host reports music control; older hosts do not expose this word."
      },
      "seconds": 0.1
    }
  ],
  "needs": [
    "windows"
  ],
  "moves": [
    {
      "id": "point",
      "name": {
        "zh": "指定位置",
        "en": "point"
      },
      "about": {
        "en": "Fly to a normalized position in the usable screen area. x goes left to right, y goes top to bottom; omitted coordinates default to 0.5."
      },
      "params": [
        {
          "id": "x",
          "about": {
            "en": "Horizontal position, left 0 to right 1"
          },
          "min": 0,
          "max": 1
        },
        {
          "id": "y",
          "about": {
            "en": "Vertical position, top 0 to bottom 1"
          },
          "min": 0,
          "max": 1
        }
      ]
    },
    {
      "id": "window-top",
      "name": {
        "zh": "窗口顶边",
        "en": "window top"
      },
      "about": {
        "en": "Fly to the nearest visible window top edge wide enough for the character and perch there. Reports no-window if no suitable edge is available. Dragging releases the perch. Does not follow a moving window."
      }
    }
  ]
}
